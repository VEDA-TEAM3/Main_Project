{
    "windowSizeMs": 35,
    "channelCount": 8,
    
    "directionalZoneMapping": true,
    "demoPedestrianProxy": true,
    "hysteresisMargin": 0.7,

    "logLevel": "info",
    "logToConsole": true,
    "logToFile": true,
    "logFlushIntervalMs": 500,
    "logMaxPendingEntries": 10000,
    "logFileName": "veda.csv",

    "risk": {
        "warningDistance": 7.0,
        "dangerousDistance": 3.0,
        "dedupMergeDistance": 0.5,
        "trackMaxDistance": 4.0,
        "positionJitterRadius": 0.7
    },

    "worldBounds": {
        "enabled": false,
        "minX": 0.0,
        "maxX": 0.0,
        "minY": 0.0,
        "maxY": 0.0
    },

    "zones": [
        { "zoneId": 0, "minX": -100.0, "maxX": 0.0, "minY": 0.0, "maxY": 100.0 },
        { "zoneId": 1, "minX": -100.0, "maxX": 0.0, "minY": 100.0, "maxY": 200.0 },
        { "zoneId": 2, "minX": -100.0, "maxX": 0.0, "minY": -100.0, "maxY": 0.0 },
        { "zoneId": 3, "minX": -100.0, "maxX": 0.0, "minY": -200.0, "maxY": -100.0 },
        
        { "zoneId": 4, "minX": 0.0, "maxX": 100.0, "minY": 0.0, "maxY": 100.0 },
        { "zoneId": 5, "minX": 0.0, "maxX": 100.0, "minY": 100.0, "maxY": 200.0 },
        { "zoneId": 6, "minX": 0.0, "maxX": 100.0, "minY": -100.0, "maxY": 0.0 },
        { "zoneId": 7, "minX": 0.0, "maxX": 100.0, "minY": -200.0, "maxY": -100.0 }
    ],

    "cameraCalibrations": [
        { "channelId": 0, "cameraPosX": -50.0, "cameraPosY": 0.0, "facingAngleDeg": 0.0,  "lateralSign": 1 },
        { "channelId": 1, "cameraPosX": -50.0, "cameraPosY": 0.0, "facingAngleDeg": 90.0, "lateralSign": -1 },
        { "channelId": 2, "cameraPosX": -50.0, "cameraPosY": 0.0, "facingAngleDeg": 180.0, "lateralSign": 1 },
        { "channelId": 3, "cameraPosX": -50.0, "cameraPosY": 0.0, "facingAngleDeg": 270.0, "lateralSign": -1 },
        
        { "channelId": 4, "cameraPosX": 50.0, "cameraPosY": 0.0, "facingAngleDeg": 0.0,  "lateralSign": 1 },
        { "channelId": 5, "cameraPosX": 50.0, "cameraPosY": 0.0, "facingAngleDeg": 90.0, "lateralSign": -1 },
        { "channelId": 6, "cameraPosX": 50.0, "cameraPosY": 0.0, "facingAngleDeg": 180.0, "lateralSign": 1 },
        { "channelId": 7, "cameraPosX": 50.0, "cameraPosY": 0.0, "facingAngleDeg": 270.0, "lateralSign": -1 }
    ],

    "hwHealthCheck": {
        "dispatcher": "serial",
        "devicePath": "/dev/serial0",
        "heartbeatIntervalMs": 500,
        "missedBeatsForTimeout": 3,
        "mismatchRetryCount": 2,
        "mismatchEscalateAfterRetries": true
    },
    
    "simulation": {
        "baseIntervalMs": 20,
        "jitterStepMs": 3
    },

    "mqttBrokerUrl": "ssl://192.168.0.13:8883",
    "mqttSendTopic": "veda/risk",
    "mqttCaFile": "/etc/veda/certs/ca.crt",
    "mqttClientId": "",
    "mqttKeepAliveSeconds": 60,
    "mqttReconnectDelaySeconds": 1,
    "mqttReconnectDelayMaxSeconds": 10,

    "mqttReceiverRetryIntervalMs": 2000
}
