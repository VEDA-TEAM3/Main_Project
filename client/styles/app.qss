* {
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 14px;
    color: #f5f9ff;
    background-color: #06101b;
    selection-background-color: #1681a6;
    selection-color: #ffffff;
}

QMainWindow,
QWidget,
QWidget#centralwidget {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #0a1a2d, stop:0.55 #071426, stop:1 #050e1b);
}

QLabel {
    background-color: transparent;
}

QFrame#topBarFrame {
    background-color: transparent;
    border: 0;
}

QFrame#topSectionFrame,
QFrame#bottomSectionFrame {
    background-color: transparent;
    border: 0;
}

QFrame#cctvCard,
QFrame#mapCard,
QFrame#eventLogCard,
QFrame#deviceStatusCard,
QFrame#objectListCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #143b56, stop:0.1 #102f48,
                                      stop:0.68 #0b2237, stop:1 #081a2b);
    border: 1px solid #397391;
    border-top-color: #58b6da;
    border-radius: 6px;
}

QFrame#legendFrame {
    background-color: transparent;
    border: 0;
}

QDialog#informationDialog {
    background-color: transparent;
}

QFrame#informationPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #123651, stop:0.42 #0c273d, stop:1 #071928);
    border: 1px solid #50c8ee;
    border-top-color: #79ddff;
    border-radius: 8px;
}

QLabel#informationTitle {
    color: #eafaff;
    background-color: transparent;
    border: 0;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 18px;
    font-weight: 700;
}

QLabel#informationMessage {
    color: #f4fbff;
    background-color: #081d2e;
    border: 1px solid #2f6685;
    border-radius: 5px;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 16px;
    font-weight: 700;
    padding: 18px 14px;
}

QPushButton#informationConfirmButton {
    min-width: 104px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 5px;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 14px;
    font-weight: 700;
}

QPushButton#informationConfirmButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #1a88b4, stop:1 #106085);
    border: 1px solid #69ddff;
    color: #ffffff;
}

QPushButton#informationConfirmButton:hover {
    background-color: #20a2d3;
    border-color: #a3efff;
}

QPushButton#informationConfirmButton:pressed {
    padding-top: 1px;
}

QFrame#eventLogBodyFrame,
QFrame#deviceStatusBodyFrame,
QFrame#objectListBodyFrame {
    background-color: #071827;
    border: 1px solid #2d566f;
    border-radius: 6px;
}

QFrame#deviceStatusBodyFrame {
    background-color: transparent;
    border: 0;
}

QStackedWidget#videoAreaStackedWidget,
QWidget#videoAreaPage1,
QWidget#videoAreaPage2 {
    background-color: transparent;
    border: 0;
}


QToolTip {
    color: #eef3f5;
    background-color: #102936;
    border: 1px solid #4c8aa3;
    border-radius: 3px;
    padding: 5px 8px;
}

DigitalTwinMapWidget#digitalTwinMapWidget {
    background-color: #06121f;
    border: 1px solid #2c5672;
    border-radius: 4px;
}

ClickableVideoWidget {
    background-color: #000000;
    border: 1px solid #294754;
    border-radius: 4px;
}

ClickableVideoWidget[loading="true"] {
    border: 1px solid #3a7187;
}

QLabel#videoChannelLabel {
    background-color: #061d2e;
    border: 1px solid #45bde2;
    border-radius: 0;
    color: #dff6ff;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
}

QLabel#videoChannelLabel[expanded="true"] {
    border-radius: 0;
    font-size: 16px;
    padding: 6px 14px;
}

QFrame#videoTileFrame {
    background-color: #0c2539;
    border: 2px solid #0c2539;
    border-radius: 4px;
}

QFrame#videoTileFrame[hovered="true"] {
    background-color: #45bde2;
    border-color: #45bde2;
}

QFrame#videoLoadingOverlay {
    background-color: #000000;
    border-radius: 4px;
}

QWidget#videoLoadingSpinner {
    background-color: transparent;
}

QLabel#videoLoadingLabel {
    color: #b9dfec;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0px;
}

QStatusBar,
QMenuBar {
    background-color: #03070d;
    color: #9eb7c7;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #030a10;
    border: 0;
    width: 10px;
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #356e91;
    border: 1px solid #519abe;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #49add7;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}
