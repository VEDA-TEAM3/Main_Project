* {
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 14px;
    color: #f5f9ff;
    background-color: #06101b;
    selection-background-color: #1681a6;
    selection-color: #ffffff;
}

QMainWindow,
QWidget,
QWidget#centralwidget,
QWidget#mainContent {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #0a1a2d, stop:0.55 #071426, stop:1 #050e1b);
}

QLabel {
    background-color: transparent;
}

QFrame#topBarFrame {
    background-color: transparent;
    border: 0;
}

QLabel#titleLabel {
    color: #f5fbfd;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 25px;
    font-weight: 700;
}

QWidget#mapSettingsDialog {
    background-color: #0b263b;
}

QFrame#mapSettingsDialogPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #123a55, stop:0.52 #0b263b, stop:1 #061726);
    border: 1px solid #59d9ff;
    border-radius: 6px;
}

QLabel#mapSettingsTitleLabel {
    color: #f5f9ff;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 24px;
    font-weight: 700;
    border-left: 3px solid #57cfff;
    padding-left: 10px;
}

QPushButton#mapSettingsCloseButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 44px;
    max-height: 44px;
    background-color: #0d2c45;
    border: 1px solid #3f7fa5;
    border-radius: 5px;
    color: #f4f8ff;
    font-size: 24px;
    font-weight: 600;
}

QPushButton#mapSettingsCloseButton:hover {
    background-color: #174667;
    border-color: #63c5ec;
}

QFrame#mapSettingsOptionsFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #0b263b, stop:0.68 #081d30, stop:1 #061726);
    border: 1px solid #397391;
    border-top: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QTabWidget#settingsTabs::pane {
    background-color: transparent;
    border: 0;
    top: 0;
}

QTabWidget#settingsTabs QTabBar {
    background-color: transparent;
    border: 0;
}

QTabWidget#settingsTabs QTabBar::tab {
    min-height: 38px;
    padding: 0 18px;
    margin: 0;
    color: #8fb7cc;
    background-color: #071a2a;
    border: 1px solid #315f7e;
    border-bottom: 2px solid #315f7e;
    border-radius: 0;
    font-size: 15px;
    font-weight: 700;
}

QTabWidget#settingsTabs QTabBar::tab:first {
    border-top-left-radius: 5px;
}

QTabWidget#settingsTabs QTabBar::tab:last {
    border-left: 0;
    border-top-right-radius: 5px;
}

QTabWidget#settingsTabs QTabBar::tab:hover {
    color: #dff8ff;
    background-color: #0d2d44;
    border-color: #4aa2c7;
    border-bottom-color: #59b8da;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    color: #ffffff;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #18516f, stop:1 #123b55);
    border-color: #4c94b7;
    border-bottom-color: #66d8ff;
}

QWidget#settingsTabPage {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #0b263b, stop:0.68 #081d30, stop:1 #061726);
    border: 0;
}

QWidget#videoPreprocessingControls {
    background-color: transparent;
}

QLabel#mapSettingsSectionLabel {
    color: #55dcff;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 18px;
    font-weight: 700;
}

QFrame#mapSettingsSectionDivider {
    min-width: 1px;
    max-width: 1px;
    background-color: #315f7e;
    border: 0;
}

QFrame#mapSettingsHorizontalDivider {
    min-height: 1px;
    max-height: 1px;
    background-color: #315f7e;
    border: 0;
}

QCheckBox#mapSettingsOption {
    color: #dceaf2;
    background-color: transparent;
    border: 0;
    spacing: 12px;
    min-height: 42px;
    font-size: 17px;
    font-weight: 600;
}

QCheckBox#mapSettingsOption::indicator {
    width: 24px;
    height: 24px;
    border: 2px solid #3f7597;
    border-radius: 4px;
    background-color: #06121f;
}

QCheckBox#mapSettingsOption::indicator:unchecked:hover {
    border-color: #57cfff;
    background-color: #0b2940;
}

QCheckBox#mapSettingsOption::indicator:checked {
    border-color: #84ddfa;
    background-color: #157fa9;
}

QCheckBox#mapSettingsOption::indicator:checked:hover {
    border-color: #e1f8ff;
    background-color: #209bc5;
}

QLabel#videoPreprocessingFieldLabel {
    min-width: 108px;
    color: #dceaf2;
    background-color: transparent;
    border: 0;
    font-size: 16px;
    font-weight: 700;
}

QLabel#videoPreprocessingValueLabel {
    color: #75ddff;
    background-color: #071827;
    border: 1px solid #315f7e;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 14px;
    font-weight: 700;
}

QSlider#videoPreprocessingSlider {
    min-height: 28px;
    background-color: transparent;
}

QSlider#videoPreprocessingSlider::groove:horizontal {
    height: 6px;
    background-color: #06131f;
    border: 1px solid #284d65;
    border-radius: 3px;
}

QSlider#videoPreprocessingSlider::sub-page:horizontal {
    background-color: #28b9e9;
    border: 1px solid #69dcff;
    border-radius: 3px;
}

QSlider#videoPreprocessingSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    background-color: #e6f9ff;
    border: 2px solid #35c9f5;
    border-radius: 9px;
}

QSlider#videoPreprocessingSlider::handle:horizontal:hover {
    background-color: #ffffff;
    border-color: #8ae8ff;
}

QComboBox#videoPreprocessingComboBox,
QComboBox#videoPreprocessingAreaComboBox,
QComboBox#videoPreprocessingChannelComboBox {
    min-height: 36px;
    color: #e6f4fa;
    background-color: #071827;
    border: 1px solid #376a88;
    border-radius: 5px;
    padding: 0 34px 0 12px;
    font-size: 15px;
    font-weight: 700;
}

QComboBox#videoPreprocessingComboBox::drop-down,
QComboBox#videoPreprocessingAreaComboBox::drop-down,
QComboBox#videoPreprocessingChannelComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border: 0;
    background-color: transparent;
}

QComboBox#videoPreprocessingComboBox::down-arrow,
QComboBox#videoPreprocessingAreaComboBox::down-arrow,
QComboBox#videoPreprocessingChannelComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QComboBox#videoPreprocessingComboBox:hover,
QComboBox#videoPreprocessingComboBox:focus,
QComboBox#videoPreprocessingAreaComboBox:hover,
QComboBox#videoPreprocessingAreaComboBox:focus,
QComboBox#videoPreprocessingChannelComboBox:hover,
QComboBox#videoPreprocessingChannelComboBox:focus {
    background-color: #0b263a;
    border-color: #58c9ed;
}

QComboBox#videoPreprocessingComboBox QAbstractItemView,
QComboBox#videoPreprocessingAreaComboBox QAbstractItemView,
QComboBox#videoPreprocessingChannelComboBox QAbstractItemView {
    color: #e6f4fa;
    background-color: #091e30;
    border: 1px solid #4a91b5;
    selection-color: #ffffff;
    selection-background-color: #17698f;
    outline: 0;
}

QWidget#videoPreprocessingControls[preprocessingActive="true"] QLabel#videoPreprocessingFieldLabel {
    color: #f2faff;
}

QWidget#videoPreprocessingControls[preprocessingActive="true"] QLabel#videoPreprocessingValueLabel {
    color: #aeeaff;
}

QWidget#videoPreprocessingControls[preprocessingActive="true"] QComboBox {
    color: #eefaff;
}

QWidget#videoPreprocessingControls[preprocessingActive="false"] QLabel,
QWidget#videoPreprocessingControls[preprocessingActive="false"] QComboBox {
    color: #587386;
}

QPushButton#videoPreprocessingSecondaryButton,
QPushButton#videoPreprocessingApplyAllButton {
    min-width: 126px;
    min-height: 38px;
    color: #cfe7f1;
    background-color: #0a2133;
    border: 1px solid #376b88;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#videoPreprocessingSecondaryButton:hover {
    color: #ffffff;
    background-color: #123b55;
    border-color: #55b3d7;
}

QPushButton#videoPreprocessingApplyAllButton {
    color: #eafaff;
    background-color: #145b7f;
    border-color: #5bc9ed;
}

QPushButton#videoPreprocessingApplyAllButton:hover {
    color: #ffffff;
    background-color: #1a779e;
    border-color: #a5edff;
}

QPushButton#mapSettingsCancelButton,
QPushButton#mapSettingsApplyButton {
    min-width: 138px;
    min-height: 48px;
    border-radius: 5px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#mapSettingsCancelButton {
    color: #cbdde6;
    background-color: #0b2032;
    border: 1px solid #365f79;
}

QPushButton#mapSettingsCancelButton:hover {
    background-color: #12344d;
    border-color: #5799b8;
}

QPushButton#mapSettingsCancelButton:pressed {
    background-color: #081724;
    border-color: #31566f;
}

QPushButton#mapSettingsApplyButton {
    color: #ffffff;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #278fbd, stop:1 #155f86);
    border: 1px solid #64c9ed;
}

QPushButton#mapSettingsApplyButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #37acd6, stop:1 #19779e);
    border-color: #d1f4ff;
}

QPushButton#mapSettingsApplyButton:pressed {
    background-color: #124f72;
    border-color: #4aa0c4;
}

QFrame#topSectionFrame,
QFrame#bottomSectionFrame {
    background-color: transparent;
    border: 0;
}

QFrame#cctvCard,
QFrame#mapCard,
QFrame#eventLogCard,
QFrame#deviceStatusCard,
QFrame#objectListCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #143b56, stop:0.1 #102f48,
                                      stop:0.68 #0b2237, stop:1 #081a2b);
    border: 1px solid #397391;
    border-top-color: #58b6da;
    border-radius: 6px;
}

QFrame#legendFrame {
    background-color: transparent;
    border: 0;
}

QDialog#informationDialog {
    background-color: transparent;
}

QFrame#informationPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #123651, stop:0.42 #0c273d, stop:1 #071928);
    border: 1px solid #50c8ee;
    border-top-color: #79ddff;
    border-radius: 8px;
}

QLabel#informationTitle {
    color: #eafaff;
    background-color: transparent;
    border: 0;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 18px;
    font-weight: 700;
}

QLabel#informationMessage {
    color: #f4fbff;
    background-color: #081d2e;
    border: 1px solid #2f6685;
    border-radius: 5px;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 16px;
    font-weight: 700;
    padding: 18px 14px;
}

QPushButton#informationConfirmButton {
    min-width: 104px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 5px;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 14px;
    font-weight: 700;
}

QPushButton#informationConfirmButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #1a88b4, stop:1 #106085);
    border: 1px solid #69ddff;
    color: #ffffff;
}

QPushButton#informationConfirmButton:hover {
    background-color: #20a2d3;
    border-color: #a3efff;
}

QPushButton#informationConfirmButton:pressed {
    padding-top: 1px;
}

QFrame#eventLogBodyFrame,
QFrame#deviceStatusBodyFrame,
QFrame#objectListBodyFrame {
    background-color: #071827;
    border: 1px solid #2d566f;
    border-radius: 6px;
}

QFrame#deviceStatusBodyFrame {
    background-color: transparent;
    border: 0;
}

QStackedWidget#videoAreaStackedWidget,
QWidget#videoAreaPage1,
QWidget#videoAreaPage2 {
    background-color: transparent;
    border: 0;
}

QFrame#deviceChannelCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #123750, stop:1 #0a2135);
    border: 1px solid #39708e;
    border-radius: 5px;
}

QFrame#deviceChannelCard[healthState="confirmed"] {
    border-color: #4385a6;
}

QFrame#deviceChannelCard[healthState="failed"] {
    border-color: #ff2f3d;
}

QLabel#deviceChannelTitleLabel {
    color: #55dcff;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 13px;
    font-weight: 700;
    padding-left: 1px;
}

QFrame#deviceStatusRow {
    background-color: #081d30;
    border: 1px solid #315e79;
    border-radius: 4px;
    min-height: 28px;
}

QLabel#deviceStatusIconLabel {
    background-color: transparent;
}

QFrame#deviceStatusSeparator {
    background-color: #356579;
    border: 0;
}

QLabel#deviceStateSegment {
    background-color: #061321;
    border: 1px solid #2a4b64;
    border-radius: 3px;
    color: #7390a1;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 11px;
    font-weight: 700;
    padding: 3px 4px;
}

QLabel#deviceStateSegment[stateKind="safe"][active="true"],
QLabel#deviceStateSegment[stateKind="off"][active="true"] {
    background-color: #07331f;
    border-color: #3df06c;
    color: #5cff80;
}

QLabel#deviceStateSegment[stateKind="warning"][active="true"] {
    background-color: #332807;
    border-color: #ffd43b;
    color: #ffe052;
}

QLabel#deviceStateSegment[stateKind="danger"][active="true"],
QLabel#deviceStateSegment[stateKind="on"][active="true"] {
    background-color: #3d0b13;
    border-color: #ff2f3d;
    color: #ff5662;
}

QLabel#deviceStateSegment[stateKind="safe"][active="false"],
QLabel#deviceStateSegment[stateKind="off"][active="false"] {
    color: #245d38;
}

QLabel#deviceStateSegment[stateKind="warning"][active="false"] {
    color: #66571a;
}

QLabel#deviceStateSegment[stateKind="danger"][active="false"],
QLabel#deviceStateSegment[stateKind="on"][active="false"] {
    color: #683035;
}

QTableView#objectListTable,
QTableView#eventLogTable {
    background-color: transparent;
    border: 0;
    color: #d9e8ee;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 12px;
    gridline-color: #1d4454;
    outline: 0;
    alternate-background-color: #091923;
}

QTableView#objectListTable::item,
QTableView#eventLogTable::item {
    border-bottom: 1px solid #1d4454;
    padding: 3px 4px;
}

QTableView#objectListTable::item:selected,
QTableView#eventLogTable::item:selected {
    background-color: #145674;
    color: #f5fdff;
}

QTableView#objectListTable QHeaderView::section,
QTableView#eventLogTable QHeaderView::section {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #163950, stop:0.22 #102e43, stop:1 #0a2032);
    border: 0;
    border-bottom: 1px solid #3aa4cf;
    color: #e2f1f6;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 4px;
}

QToolTip {
    color: #eef3f5;
    background-color: #102936;
    border: 1px solid #4c8aa3;
    border-radius: 3px;
    padding: 5px 8px;
}

QWidget#eventLogScrollHeaderCover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #163950, stop:0.22 #102e43, stop:1 #0a2032);
    border: 0;
    border-bottom: 1px solid #3aa4cf;
}

DigitalTwinMapWidget#digitalTwinMapWidget {
    background-color: #06121f;
    border: 1px solid #2c5672;
    border-radius: 4px;
}

ClickableVideoWidget {
    background-color: #000000;
    border: 1px solid #294754;
    border-radius: 4px;
}

ClickableVideoWidget[loading="true"] {
    border: 1px solid #3a7187;
}

QLabel#videoChannelLabel {
    background-color: #061d2e;
    border: 1px solid #45bde2;
    border-left: 3px solid #55dcff;
    border-radius: 0;
    color: #dff6ff;
    font-family: "Noto Sans KR", "Malgun Gothic", "Segoe UI";
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
}

QLabel#videoChannelLabel[expanded="true"] {
    border-left-width: 4px;
    border-radius: 0;
    font-size: 16px;
    padding: 6px 14px;
}

QFrame#videoTileFrame {
    background-color: #0c2539;
    border: 2px solid #0c2539;
    border-radius: 4px;
}

QFrame#videoTileFrame[hovered="true"] {
    background-color: #45bde2;
    border-color: #45bde2;
}

QFrame#videoLoadingOverlay {
    background-color: #000000;
    border-radius: 4px;
}

QWidget#videoLoadingSpinner {
    background-color: transparent;
}

QLabel#videoLoadingLabel {
    color: #b9dfec;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0px;
}

QStatusBar,
QMenuBar {
    background-color: #03070d;
    color: #9eb7c7;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #030a10;
    border: 0;
    width: 10px;
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #356e91;
    border: 1px solid #519abe;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #49add7;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}
