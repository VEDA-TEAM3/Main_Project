{
    "application": {
        "windowWidth": 1680,
        "windowHeight": 945
    },
    "logging": {
        "mqttConnection": true,
        "mqttStatusPayload": false,
        "mqttRisk": false,
        "mqttBlur": false,
        "blurApply": false,
        "blurDispatch": false,
        "riskDispatch": false,
        "topview": false,
        "topviewDetail": false,
        "topviewDetailIntervalMs": 1000
    },
    "digitalTwin": {
        "renderIntervalMs": 33,
        "snapshotPublishIntervalMs": 50,
        "frameExpiryMs": 5000,
        "frameExpiryPollMs": 1000,
        "positionTransitionMs": 66,
        "fadeInMs": 120,
        "missingGraceMs": 100,
        "fadeOutMs": 180,
        "maximumHistorySize": 2,
        "diagnosticsIntervalMs": 1000,
        "icons": {
            "vehiclePx": 70,
            "pedestrianPx": 52
        },
        "world": {
            "fixedBoundsEnabled": true,
            "invertY": true,
            "automaticBoundsWarmupMs": 500,
            "automaticBoundsMinimumSamples": 12,
            "automaticBoundsMaximumSamples": 512,
            "automaticBoundsPaddingRatio": 0.08,
            "automaticBoundsOutlierFraction": 0.05,
            "minX": -80.0,
            "minY": -40.0,
            "maxX": 80.0,
            "maxY": 40.0
        }
    },
    "video": {
        "initialStartDelayMs": 1000,
        "receiverStartSpacingMs": 3000,
        "initialAreaId": "area-01",
        "areas": [
            { "areaId": "area-01", "name": "제 1구역", "streamIds": ["cam-01", "cam-02", "cam-03", "cam-04"] },
            { "areaId": "area-02", "name": "제 2구역", "streamIds": ["cam-05", "cam-06", "cam-07", "cam-08"] }
        ],
        "streams": [
            { "cameraId": "cam-01", "name": "CH - 01", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/0/profile4/media.smp", "channelIndex": 0, "enabled": true },
            { "cameraId": "cam-02", "name": "CH - 02", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/1/profile4/media.smp", "channelIndex": 1, "enabled": true },
            { "cameraId": "cam-03", "name": "CH - 03", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/2/profile4/media.smp", "channelIndex": 2, "enabled": true },
            { "cameraId": "cam-04", "name": "CH - 04", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/3/profile4/media.smp", "channelIndex": 3, "enabled": true },
            { "cameraId": "cam-05", "name": "CH - 05", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/0/profile4/media.smp", "channelIndex": 4, "enabled": true },
            { "cameraId": "cam-06", "name": "CH - 06", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/1/profile4/media.smp", "channelIndex": 5, "enabled": true },
            { "cameraId": "cam-07", "name": "CH - 07", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/2/profile4/media.smp", "channelIndex": 6, "enabled": true },
            { "cameraId": "cam-08", "name": "CH - 08", "url": "rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/3/profile4/media.smp", "channelIndex": 7, "enabled": true }
        ],
        "receiver": {
            "decoderMode": "auto",
            "busPollIntervalMs": 200,
            "latencyMs": 250,
            "dropOnLatency": true,
            "initialPacketTimeoutMs": 10000,
            "initialFrameTimeoutMs": 10000,
            "maximumReconnectDelayMs": 5000,
            "authenticationFailureReconnectDelayMs": 120000,
            "stallTimeoutMs": 8000,
            "udpBufferSizeBytes": 4194304,
            "tcpTimeoutUs": 20000000,
            "udpTimeoutUs": 5000000,
            "probationPackets": 2,
            "rtspKeepAlive": true,
            "udpReconnect": true,
            "addReferenceTimestampMeta": true,
            "decodeQueueMaximumBuffers": 8,
            "decodeQueueMaximumTimeMs": 100,
            "alignmentDelayMs": 100,
            "alignmentQueueMaximumTimeMs": 450,
            "renderQueueMaximumBuffers": 1,
            "renderQueueMaximumTimeMs": 200,
            "sinkQos": false,
            "sinkSync": false,
            "sinkAsync": false,
            "minimumLoadingMs": 700,
            "reconnectSpreadMs": 3000,
            "preprocessing": {
                "enabled": true,
                "preset": "custom",
                "brightness": 0,
                "contrast": 1.0,
                "gamma": 1.0
            },
            "blur": {
                "syncOffsetMs": 300,
                "historyMs": 10000,
                "matchToleranceMs": 250,
                "holdLastMetadataMs": 1000,
                "maximumHistorySize": 300,
                "sourceRestartGapMs": 5000,
                "sourceTimestampRestartThresholdMs": 2000,
                "paddingRatio": 0.18,
                "radiusDivisor": 3,
                "minimumRadius": 4,
                "maximumRadius": 28,
                "debugLogIntervalMs": 1000
            }
        }
    },
    "mqtt": {
        "host": "127.0.0.1",
        "port": 8883,
        "caCertificatePath": "C:/path/to/ca.crt",
        "clientIdPrefix": "qt-device-status",
        "keepAliveSeconds": 60,
        "reconnectIntervalMs": 3000,
        "debugLogging": true,
        "blurDebugLogIntervalMs": 1000,
        "riskDebugLogIntervalMs": 1000,
        "maximumDebugPayloadLength": 512,
        "topics": {
            "controllerStatus": { "filter": "veda/hw/ch/+/status", "qos": 1 },
            "centralStatus": { "filter": "veda/hw/status", "qos": 1 },
            "sensorAlive": { "filter": "veda/ch/+/alive", "qos": 1 },
            "centralEvent": { "filter": "veda/qt/event", "qos": 1 },
            "risk": { "filter": "veda/risk", "qos": 0 },
            "blur": { "filter": "veda/ch/+/blur", "qos": 0 }
        },
        "dispatcher": {
            "blurFlushIntervalMs": 10,
            "blurSourceRestartGapMs": 5000,
            "blurTimestampRestartThresholdMs": 2000,
            "riskFlushIntervalMs": 5,
            "riskSourceRestartGapMs": 5000
        }
    }
}
